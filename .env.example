# Stillpoint server example configuration.
# Copy this file to .env and adjust values for your host.

# -----------------------------------------------------------------------------
# Standalone server settings
# -----------------------------------------------------------------------------

SERVER_ADMIN_PASSWORD=change-me-to-a-secure-password
STILLPOINT_VAULTS_ROOT=/opt/stillpoint/vaults
AUTH_ENABLED=true
STILLPOINT_SERVER_HOST=0.0.0.0
STILLPOINT_SERVER_PORT=8000
STILLPOINT_SERVER_INSECURE=0
IGNORE__FILE_PERMISSION_CHECK=false

# -----------------------------------------------------------------------------
# Home Base retention janitor settings
# -----------------------------------------------------------------------------

SP_HOMEBASE_GC_KEEP_LATEST=50
SP_HOMEBASE_GC_KEEP_ALL_DAYS=7
SP_HOMEBASE_GC_KEEP_DAILY_DAYS=30
SP_HOMEBASE_GC_KEEP_WEEKLY_DAYS=90
SP_HOMEBASE_GC_MIN_CHECKPOINTS=1
SP_HOMEBASE_GC_DRY_RUN=0
SP_HOMEBASE_GC_FORCE=0
SP_HOMEBASE_GC_INTERVAL_SECONDS=86400

# -----------------------------------------------------------------------------
# Optional logging / diagnostics
# -----------------------------------------------------------------------------

ZIMX_DETAILED_LOGGING=0
ZIMX_DETAILED_PAGE_LOGGING=0
ZIMX_MINIMAL_FONT_SCAN=0